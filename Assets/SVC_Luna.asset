            (-u_xlat1.xy);\n    u_xlat2.xy = u_xlat12.xy + u_xlat2.xy;\n    u_xlat12.xy
            = vs_TEXCOORD2.zw;\n    u_xlat2.xy = u_xlat12.xy * u_xlat2.xy;\n    u_xlat2.xy
            = max(u_xlat2.xy, vec2(0.0, 0.0));\n    u_xlat2.xy = min(u_xlat2.xy,
            vec2(1.0, 1.0));\n    u_xlat16_2.xy = u_xlat2.xy;\n    u_xlat16_3 = u_xlat16_2.y
            * u_xlat16_2.x;\n    u_xlat16_0 = u_xlat16_0 * vec4(u_xlat16_3);\n   
            u_xlat16_3 = 0.00100000005;\n    u_xlat16_3 = (-u_xlat16_3);\n    u_xlat16_3
            = u_xlat16_0.w + u_xlat16_3;\n    u_xlat3 = u_xlat16_3;\n    u_xlatb4
            = u_xlat3<0.0;\n    u_xlati4 = u_xlatb4 ? int(0xFFFFFFFFu) : int(0);\n   
            if((u_xlati4)!=0){discard;}\n    SV_Target0 = u_xlat16_0;\n    return;\n}\n\n"
