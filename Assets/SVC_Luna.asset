            * u_xlat16_4.x;\n    u_xlat16_12.x = u_xlat16_12.x * u_xlat16_12.x;\n   
            u_xlat16_4.x = u_xlat16_4.x * u_xlat16_12.x;\n    u_xlat16_12.x = u_xlat16_26
            * u_xlat16_4.x + 1.0;\n    u_xlat8.x = dot(u_xlat3.xyz, _WorldSpaceLightPos0.xyz);\n   
            u_xlat8.x = clamp(u_xlat8.x, 0.0, 1.0);\n    u_xlat16_20 = (-u_xlat8.x)
            + 1.0;\n    u_xlat16_28 = u_xlat16_20 * u_xlat16_20;\n    u_xlat16_28
            = u_xlat16_28 * u_xlat16_28;\n    u_xlat16_20 = u_xlat16_20 * u_xlat16_28;\n   
            u_xlat16_26 = u_xlat16_26 * u_xlat16_20 + 1.0;\n    u_xlat16_26 = u_xlat16_12.x
            * u_xlat16_26;\n    u_xlat8.x = u_xlat8.x * u_xlat16_26;\n    u_xlat16_2.xyz
            = u_xlat8.xxx * u_xlat16_2.xyz;\n    u_xlat3.w = 1.0;\n    u_xlat16_5.x
            = dot(unity_SHAr, u_xlat3);\n    u_xlat16_5.y = dot(unity_SHAg, u_xlat3);\n   
            u_xlat16_5.z = dot(unity_SHAb, u_xlat3);\n    u_xlat16_12.xyz = u_xlat16_5.xyz
            + vs_TEXCOORD5.xyz;\n    u_xlat16_12.xyz = max(u_xlat16_12.xyz, vec3(0.0,
            0.0, 0.0));\n    u_xlat8.xyz = log2(u_xlat16_12.xyz);\n    u_xlat8.xyz
            = u_xlat8.xyz * vec3(0.416666657, 0.416666657, 0.416666657);\n    u_xlat8.xyz
            = exp2(u_xlat8.xyz);\n    u_xlat8.xyz = u_xlat8.xyz * vec3(1.05499995,
            1.05499995, 1.05499995) + vec3(-0.0549999997, -0.0549999997, -0.0549999997);\n   
            u_xlat8.xyz = max(u_xlat8.xyz, vec3(0.0, 0.0, 0.0));\n    u_xlat16_1
            = texture(_OcclusionMap, vs_TEXCOORD0.xy).y;\n    u_xlat16_26 = (-_OcclusionStrength)
            + 1.0;\n    u_xlat16_26 = u_xlat16_1 * _OcclusionStrength + u_xlat16_26;\n   
            u_xlat16_2.xyz = u_xlat8.xyz * vec3(u_xlat16_26) + u_xlat16_2.xyz;\n   
            u_xlat16_12.xyz = vec3(u_xlat16_26) * unity_IndirectSpecColor.xyz;\n   
            u_xlat8.x = u_xlat0.x * u_xlat0.x;\n    u_xlat8.x = max(u_xlat8.x, 0.00200000009);\n   
            u_xlat0.x = u_xlat8.x * u_xlat0.x;\n    u_xlat0.x = (-u_xlat0.x) * 0.280000001
            + 1.0;\n    u_xlat16_12.xyz = u_xlat16_12.xyz * u_xlat0.xxx;\n    u_xlat16_26
            = (-_Metallic) * 0.779083729 + 0.779083729;\n    u_xlat16_5.x = (-u_xlat16_26)
            + 1.0;\n    u_xlat16_5.x = u_xlat16_5.x + _Glossiness;\n    u_xlat16_5.x
            = clamp(u_xlat16_5.x, 0.0, 1.0);\n    u_xlat16_0.xyz = texture(_MainTex,
