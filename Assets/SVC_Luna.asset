            layout(std140)\n#endif\nUNITY_LOCATION(0) uniform mediump sampler2D _MainTex;\nin
            mediump  vec4 vs_COLOR0;\nin highp  vec4 vs_TEXCOORD0;\nin mediump  vec4
            vs_TEXCOORD1;\nlayout(location = 0) out mediump vec4 SV_Target0;\nfloat
            u_xlat0;\nmediump vec4 u_xlat16_0;\nmediump float u_xlat16_1;\nfloat
            u_xlat2;\nvoid main()\n{\n    u_xlat16_0.x = texture(_MainTex, vs_TEXCOORD0.xy).w;\n   
            u_xlat2 = vs_TEXCOORD1.x;\n    u_xlat0 = u_xlat2 * u_xlat16_0.x;\n   
            u_xlat16_0.x = u_xlat0;\n    u_xlat16_1 = (-vs_TEXCOORD1.w);\n    u_xlat16_1
            = u_xlat16_0.x + u_xlat16_1;\n    u_xlat16_1 = max(u_xlat16_1, 0.0);\n   
            u_xlat16_1 = min(u_xlat16_1, 1.0);\n    u_xlat16_0 = vec4(u_xlat16_1)
            * vs_COLOR0;\n    SV_Target0 = u_xlat16_0;\n    return;\n}\n\n"
