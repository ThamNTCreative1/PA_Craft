            _Glossiness;\nUNITY_LOCATION(0) uniform mediump sampler2D _MainTex;\nUNITY_LOCATION(1)
            uniform mediump sampler2D _ShadowMapTexture;\nin highp  vec4 vs_TEXCOORD0;\nin
