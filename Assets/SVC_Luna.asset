            u_xlat15.xy = u_xlat15.xy + vec2(1.0, 1.0);\n    u_xlat3.xy = u_xlat15.xy
            * vec2(0.159999996, 0.159999996);\n    u_xlat15.xy = min(u_xlat0.xy,
            vec2(0.0, 0.0));\n    u_xlat4.xy = (-u_xlat0.xy) + vec2(1.0, 1.0);\n   
