+                    if (body.position.z > 2) { crossed = true; break; }
+                }
+                bool shouldCross = !tall && !overhead && !brake && !release;
+                if (scenario == 9) File.WriteAllLines(Folder + "car-fast-trajectory.txt", trajectory);
