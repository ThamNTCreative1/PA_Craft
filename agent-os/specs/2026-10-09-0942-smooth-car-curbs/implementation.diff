+                    (!shouldCross || (minSpeed > (fast ? 3f : 1.5f) && maxHeight < 100 + height + 0.09f)),
+                    "Car scenario=" + scenario + " curb=" + height + " crossed=" + crossed +
+                    " maxTickRise=" + maxRise.ToString("F4") + " maxY=" + maxHeight.ToString("F3") + " minSpeed=" + minSpeed.ToString("F3"));
+            }
+            File.WriteAllLines(Folder + "car-curb-checks.txt", Results);
